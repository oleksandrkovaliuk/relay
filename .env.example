# Created automatically by `pnpm exec convex dev --once`.
VITE_CONVEX_URL=

# Optional override for packaged apps that cannot discover Claude on PATH.
CLAUDE_BINARY_PATH=

# Optional isolated Claude profile. Keep HOME unchanged so macOS Keychain login works.
CLAUDE_CONFIG_DIR=

# Origin of the hosted student player. Required for production builds so copied
# homework links point at the matching deployment. Development alone falls back
# to localhost:5180 when this is empty.
# Convex serves the player at <deployment>.convex.site by default; a branded
# domain (e.g. https://homework.relay.app) needs a Convex custom domain.
VITE_PLAYER_ORIGIN=

# ── Sign-in (Clerk session + Convex integration) ─────────────────────────────
# Public key from Clerk Dashboard → API keys. Use pk_test_ locally and pk_live_
# for a production desktop build. VITE_ values are public and baked into the app.
VITE_CLERK_PUBLISHABLE_KEY=

# The matching issuer on the Convex deployment is set separately:
#   npx convex env set CLERK_FRONTEND_API_URL https://clerk.<your-domain> --prod
# Activate Clerk Dashboard → Integrations → Convex first; it adds the required
# `aud: "convex"` claim. There is no CLERK_OAUTH_CLIENT_ID.
#
# Native redirect URL used while Google sign-in is in flight:
#   relay://renderer/
# Register it in Clerk's Native applications SSO redirect allowlist.
