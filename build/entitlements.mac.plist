<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs JIT. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      Relay spawns the teacher's own Claude Code CLI, which is not signed by us.
      Library validation would refuse to load it. This is also why the app cannot
      be sandboxed, and therefore cannot ship on the Mac App Store.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- The CLI opens a browser and talks to Anthropic and Convex. -->
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
