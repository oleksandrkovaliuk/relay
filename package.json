{
  "name": "relay-teacher-desktop",
  "productName": "Relay",
  "version": "0.1.0",
  "private": true,
  "description": "Relay — a one-to-one teacher workspace with interactive homework and live learning insights.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "convex dev --start \"pnpm dev:desktop\"",
    "dev:convex": "convex dev",
    "dev:desktop": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "generate:routes": "tsr generate",
    "build": "pnpm generate:routes && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "host:web": "static-hosting upload --dist out/web --build-command \"pnpm build:web\"",
    "deploy:web": "static-hosting deploy --dist out/web --build-command \"pnpm build:web\"",
    "typecheck": "pnpm generate:routes && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run && vitest run --config vitest.convex.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:web",
    "package": "pnpm build && electron-builder --publish never",
    "package:mac": "pnpm build && electron-builder --mac --publish never",
    "release": "pnpm build && electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@base-ui/react": "^1.7.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-router": "^1.170.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.43.0",
    "convex-helpers": "^0.1.122",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.468.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.29",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.55",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "author": {
    "name": "Oleksandr Kovaliuk",
    "email": "okovaliukk@proton.me"
  }
}
